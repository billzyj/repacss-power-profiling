[Unit]
Description=REPACSS in-band stage-out for %i
After=network-online.target remote-fs.target

[Service]
Type=simple
EnvironmentFile=/run/repacss-power/%i.env
ExecStart=/bin/sh -lc 'exec "${REPACSS_POWER_PYTHON:-python3}" -m inband.stager'
# A failed publication keeps the local spool, so retrying is always safe.
Restart=on-failure
RestartSec=60
TimeoutStopSec=30
