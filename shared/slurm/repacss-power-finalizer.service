[Unit]
Description=REPACSS in-band finalizer
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=simple
# Run as the controller's SlurmUser, the identity that EpilogSlurmctld uses to write
# the queue and the OOB reports. All site settings, including the installation, come
# from the EnvironmentFile; see repacss-power-controller.env.example.
User=slurm
EnvironmentFile=/etc/repacss-power/controller.env
ExecStart=/usr/bin/env ${REPACSS_POWER_PYTHON} -m shared.slurm.finalizer run
# matplotlib keeps its font cache here, so the report plots do not rescan the fonts at
# every start; systemd creates /var/cache/repacss-power owned by the service user.
CacheDirectory=repacss-power
Environment=MPLCONFIGDIR=/var/cache/repacss-power/matplotlib
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
