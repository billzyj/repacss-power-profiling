# Site settings for repacss-power-finalizer.service and repacss-power-deliver.service.
# Install as /etc/repacss-power/controller.env, owned by root, mode 0644. It holds paths
# only: no credentials, because the finalizer and delivery never query the database.
#
# Installation: the interpreter and the repository it imports.
REPACSS_POWER_PYTHON=/opt/repacss-power-profiling/.venv/bin/python
PYTHONPATH=/opt/repacss-power-profiling
#
# Queue written by EpilogSlurmctld on this controller.
REPACSS_POWER_IB_QUEUE_ROOT=/var/spool/repacss-power/finalize-queue
# Shared staging that the compute nodes publish to.
MONSTER_POWER_IB_STORE_ROOT=/var/lib/repacss-power/staging
# Shared report root: <root>/<user>/<job_id>/{oob,ib}/. Must match the OOB wrapper's base.
REPACSS_POWER_REPORT_ROOT=/var/lib/repacss-power/reports
