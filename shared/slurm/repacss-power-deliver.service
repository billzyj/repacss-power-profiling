[Unit]
Description=REPACSS power report delivery into job owners' directories
Wants=network-online.target
After=network-online.target remote-fs.target

[Service]
Type=simple
# Root only so that each delivery can switch to the job owner before it touches a path;
# see shared/slurm/delivery.py. The finalizer and the OOB handler keep running as
# SlurmUser and write the shared copy that delivery leaves in place. All site settings
# come from the EnvironmentFile; see repacss-power-controller.env.example.
User=root
EnvironmentFile=/etc/repacss-power/controller.env
ExecStart=/usr/bin/env ${REPACSS_POWER_PYTHON} -m shared.slurm.delivery run
Restart=on-failure
RestartSec=30
# Switch identity (SETUID, SETGID), use SlurmUser's queue directory (DAC_*), and stop a
# hung delivery child that already runs as the user (KILL). Nothing else.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
