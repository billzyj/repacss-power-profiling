# REPACSS Power Measurement Configuration Template
# Copy this file to .env and fill in your actual values

# Database Settings
REPACSS_DB_HOST=localhost
REPACSS_DB_PORT=5432
REPACSS_DB_DEFAULT=h100
REPACSS_DB_USER=your_database_user
REPACSS_DB_PASSWORD=your_database_password
REPACSS_DB_SSL_MODE=prefer

# SSH Settings
REPACSS_SSH_HOSTNAME=your.ssh.host.com
REPACSS_SSH_PORT=22
REPACSS_SSH_USERNAME=your_ssh_username
REPACSS_SSH_KEY_PATH=/path/to/your/private/key
REPACSS_SSH_PASSPHRASE=
REPACSS_SSH_KEEPALIVE=60

# Slurm REST API Settings
# `HEADNODE` is the SSH target used to run `scontrol token`.
# `USER` is sent in the Slurm REST request header, not used as the SSH login user.
REPACSS_SLURM_REST_HOST=nuetu
REPACSS_SLURM_REST_PORT=6820
REPACSS_SLURM_REST_USER=yongzhao
REPACSS_SLURM_REST_HEADNODE=repacss
REPACSS_SLURM_REST_JOBS_PATH=/slurm/v0.0.42/jobs/
REPACSS_SLURM_REST_NODES_PATH=/slurm/v0.0.42/nodes/
REPACSS_SLURM_REST_JOB_PATH=/slurm/v0.0.42/job/
REPACSS_SLURM_REST_DB_JOB_PATH=/slurmdb/v0.0.42/job/
REPACSS_SLURM_REST_OPENAPI_PATH=/openapi/v3
